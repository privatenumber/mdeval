{
	"name": "mdeval",
	"version": "0.0.0-semantic-release",
	"description": "Evaluate JavaScript in markdown HTML comments and interpolate results in-place",
	"keywords": [
		"markdown",
		"eval",
		"interpolation",
		"dynamic",
		"readme"
	],
	"license": "MIT",
	"repository": "privatenumber/mdeval",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli.mjs",
	"exports": {
		".": "./dist/runtime.mjs",
		"./loader": "./dist/loader.mjs"
	},
	"imports": {
		"#md-loader": "./dist/md-loader.mjs"
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"build": "pkgroll --minify",
		"test": "pnpm build && node tests/index.ts",
		"type-check": "tsc",
		"lint": "lintroll --cache --git .",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=20.19"
	},
	"dependencies": {
		"@jridgewell/gen-mapping": "^0.3.13",
		"ansis": "^4.4.0",
		"cleye": "^2.7.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-gfm-footnote": "^2.1.0",
		"mdast-util-gfm-table": "^2.0.0",
		"mdast-util-to-hast": "^13.2.1",
		"micromark": "^4.0.3",
		"micromark-extension-gfm-footnote": "^2.1.0",
		"micromark-extension-gfm-table": "^2.1.2",
		"parse5": "^8.0.1",
		"tinyglobby": "^0.2.17",
		"unist-util-visit-parents": "^6.1.0",
		"zx": "8.8.5-lite"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/unist": "^3.0.3",
		"clean-pkg-json": "^2.0.0",
		"fs-fixture": "^2.16.0",
		"lintroll": "^1.33.0",
		"manten": "^2.0.2",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.29.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	}
}
