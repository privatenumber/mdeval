{
	"name": "mdeval",
	"version": "0.0.0-semantic-release",
	"description": "Evaluate JavaScript in markdown HTML comments and interpolate results in-place",
	"keywords": [
		"markdown",
		"eval",
		"interpolation",
		"dynamic",
		"readme"
	],
	"license": "MIT",
	"repository": "privatenumber/mdeval",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli.mjs",
	"imports": {
		"#md-loader": "./dist/md-loader.mjs"
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"build": "pkgroll --minify",
		"test": "pnpm build && node tests/index.ts",
		"type-check": "tsc",
		"lint": "lintroll --cache --git .",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"cleye": "^2.3.0",
		"md4x": "^0.0.25",
		"zx": "8.8.5-lite"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"clean-pkg-json": "^1.4.1",
		"fs-fixture": "^2.12.0",
		"lintroll": "^1.30.0",
		"manten": "^2.0.0",
		"pkgroll": "^2.27.0",
		"skills-npm": "^1.1.1",
		"typescript": "^6.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
