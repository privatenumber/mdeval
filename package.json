{
	"name": "mdeval",
	"version": "0.0.0-semantic-release",
	"description": "Evaluate JavaScript or TypeScript in markdown HTML comments and interpolate results in-place",
	"keywords": [
		"markdown",
		"eval",
		"interpolation",
		"dynamic",
		"readme",
		"typescript"
	],
	"license": "MIT",
	"repository": "privatenumber/mdeval",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli.mjs",
	"exports": {
		".": {
			"types": "./dist/runtime.d.mts",
			"default": "./dist/runtime.mjs"
		},
		"./globals": {
			"types": "./dist/globals.d.mts"
		},
		"./loader": "./dist/loader.mjs"
	},
	"imports": {
		"#content-mapper": "./dist/content-mapper.mjs"
	},
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"build": "pkgroll --minify --export-condition=node",
		"test": "pnpm build && node tests/index.ts",
		"type-check": "node node_modules/typescript/bin/tsc",
		"lint": "lintroll --cache --git .",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": "^22.21.1 || >=24.11.0"
	},
	"dependencies": {
		"@jridgewell/gen-mapping": "^0.3.13",
		"@types/fs-extra": "^11.0.4",
		"cleye": "^2.3.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-gfm-footnote": "^2.1.0",
		"mdast-util-gfm-table": "^2.0.1",
		"mdast-util-to-hast": "^13.2.1",
		"micromark": "^4.0.3",
		"micromark-extension-gfm-footnote": "^2.1.0",
		"micromark-extension-gfm-table": "^2.1.2",
		"parse5": "^8.1.0",
		"picomatch": "^4.0.4",
		"tinyglobby": "^0.2.17",
		"unist-util-visit-parents": "^6.1.0",
		"zx": "8.8.5-lite"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/picomatch": "^4.0.3",
		"@types/unist": "^3.0.3",
		"clean-pkg-json": "^2.1.0",
		"fs-fixture": "^2.16.0",
		"lintroll": "^1.34.1",
		"manten": "^2.0.2",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.29.0",
		"ts-content-mapper": "0.1.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript7": "npm:typescript@7.1.0-beta"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"dist/content-mapper.mjs"
			]
		}
	}
}
