{
	"name": "mdeval",
	"version": "0.0.0-semantic-release",
	"description": "Evaluate JavaScript in markdown HTML comments and interpolate results in-place",
	"keywords": [
		"markdown",
		"eval",
		"interpolation",
		"dynamic",
		"readme"
	],
	"license": "MIT",
	"repository": "privatenumber/mdeval",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli.mjs",
	"exports": {
		".": {
			"types": "./dist/runtime.d.mts",
			"default": "./dist/runtime.mjs"
		},
		"./loader": "./dist/loader.mjs"
	},
	"imports": {
		"#md-loader": "./dist/md-loader.mjs",
		"#content-mapper": "./dist/content-mapper.mjs"
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"build": "pkgroll --minify --export-condition=node --license=dist/LICENSE",
		"test": "pnpm build && node tests/index.ts",
		"type-check": "node node_modules/typescript/bin/tsc",
		"lint": "lintroll --cache --git .",
		"prepack": "pnpm build && clean-pkg-json --keep typescript",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=20.19"
	},
	"dependencies": {
		"@jridgewell/gen-mapping": "^0.3.13",
		"@types/fs-extra": "^11.0.4",
		"ansis": "^4.3.0",
		"cleye": "^2.3.0",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-gfm-footnote": "^2.1.0",
		"mdast-util-gfm-table": "^2.0.0",
		"mdast-util-to-hast": "^13.2.1",
		"micromark": "^4.0.2",
		"micromark-extension-gfm-footnote": "^2.1.0",
		"micromark-extension-gfm-table": "^2.1.1",
		"parse5": "^8.0.1",
		"tinyglobby": "^0.2.15",
		"unist-util-visit-parents": "^6.0.2",
		"zx": "8.8.5-lite"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@types/unist": "^3.0.3",
		"clean-pkg-json": "^1.4.1",
		"fs-fixture": "^2.12.0",
		"lintroll": "^1.30.0",
		"manten": "^2.0.0",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.27.0",
		"skills-npm": "^1.2.0",
		"ts-content-mapper": "0.1.0",
		"typescript": "^6.0.2",
		"typescript-mapper-tests": "npm:typescript@7.1.0-beta"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"dist/content-mapper.mjs"
			]
		}
	}
}
